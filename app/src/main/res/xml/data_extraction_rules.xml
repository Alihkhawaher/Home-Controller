<?xml version="1.0" encoding="utf-8"?>
<!--
    No cloud: nothing goes to cloud backup. Moving to a new phone (device-to-device transfer) brings the saved
    devices, rooms and automations along.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="home/" />
    </device-transfer>
</data-extraction-rules>
